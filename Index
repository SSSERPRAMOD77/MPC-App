 <!DOCTYPE html>
<html>
<head>
  <style>
    body { font-family: 'Segoe UI', sans-serif; background: #eef2f3; display: flex; justify-content: center; padding: 10px; }
    .card { background: white; width: 100%; max-width: 450px; padding: 25px; border-radius: 12px; box-shadow: 0 5px 15px rgba(0,0,0,0.1); }
    h2 { text-align: center; color: #2c3e50; margin-bottom: 20px; }
    .input-box { margin-bottom: 15px; }
    label { font-weight: bold; font-size: 13px; color: #555; display: block; margin-bottom: 5px; }
    input, select { width: 100%; padding: 12px; border: 1px solid #ccc; border-radius: 6px; box-sizing: border-box; }
    input[readonly] { background: #fff5f0; color: #d35400; font-weight: bold; border: 1px solid #ff7f50; }
    button { width: 100%; padding: 15px; background: #2980b9; color: white; border: none; border-radius: 6px; font-size: 16px; cursor: pointer; }
    .modal { display: none; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: white; padding: 30px; border-radius: 10px; box-shadow: 0 0 20px rgba(0,0,0,0.3); z-index: 10; text-align: center; width: 80%; max-width: 300px; }
    .overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 5; }
  </style>
</head>
<body>
  <div class="card">
    <h2>MPC Record Manager</h2>
    <div class="input-box">
      <label>Select MPC Number</label>
      <select id="mpcNo" onchange="fetchCode()"><option>Loading...</option></select>
    </div>
    <div class="input-box"><label>MPC Code (Auto)</label><input type="text" id="mpcCode" readonly></div>
    <div class="input-box"><label>Leader Name</label><input type="text" id="leader"></div>
    <div class="input-box"><label>Upline</label><input type="text" id="upline"></div>
    <div class="input-box"><label>Guest Name</label><input type="text" id="guest"></div>
    <div class="input-box"><label>Sale (BV)</label><input type="number" id="bv"></div>
    <div class="input-box"><label>Aadhar Number</label><input type="text" id="aadhar"></div>
    <div class="input-box"><label>PAN Number</label><input type="text" id="pan"></div>
    <button onclick="saveData()">Submit Record</button>
  </div>
  <div id="overlay" class="overlay"></div>
  <div id="modal" class="modal"><h3 id="mTitle"></h3><p id="mBody"></p><button onclick="location.reload()">OK</button></div>
  <script>
    window.onload = function() {
      google.script.run.withSuccessHandler(function(list) {
        var d = document.getElementById('mpcNo');
        d.innerHTML = '<option value="">-- Select --</option>';
        list.forEach(function(i) { var o = document.createElement('option'); o.value = o.text = i; d.appendChild(o); });
      }).getMpcList();
    };
    function fetchCode() {
      google.script.run.withSuccessHandler(function(c) { document.getElementById('mpcCode').value = c; })
      .getMpcCode(document.getElementById('mpcNo').value);
    }
    function saveData() {
      var d = {
        mpcNo: document.getElementById('mpcNo').value, mpcCode: document.getElementById('mpcCode').value,
        issuedTo: document.getElementById('leader').value, upline: document.getElementById('upline').value,
        guest: document.getElementById('guest').value, saleBv: document.getElementById('bv').value,
        aadhar: document.getElementById('aadhar').value, pan: document.getElementById('pan').value
      };
      google.script.run.withSuccessHandler(function(res) {
        var m = document.getElementById('modal'); var o = document.getElementById('overlay');
        document.getElementById('mTitle').innerText = res.status === "exists" ? "Already Saved" : "Congratulations!";
        document.getElementById('mBody').innerText = res.status === "exists" ? "Used by " + res.guest : "MPC Code: " + res.code;
        m.style.display = o.style.display = 'block';
      }).submitRecord(d);
    }
  </script>
</body>
</html>
