<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SafeShop MPC Portal</title>
    <style>
        :root { --primary: #1a73e8; --gold: #D4AF37; }
        body { font-family: 'Segoe UI', sans-serif; background: #f0f2f5; padding: 15px; margin: 0; }
        .card { background: white; padding: 25px; border-radius: 15px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); max-width: 500px; margin: auto; }
        h2 { color: var(--primary); text-align: center; margin-bottom: 20px; }
        label { display: block; margin: 15px 0 5px; font-weight: bold; font-size: 14px; color: #333; }
        .required-star { color: #d93025; font-weight: bold; }
        input, select { width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 8px; box-sizing: border-box; font-size: 16px; }
        input:focus, select:focus { border-color: var(--primary); outline: none; }
        input:disabled { background: #eeeeee; cursor: not-allowed; }
        .btn { background: var(--primary); color: white; border: none; width: 100%; padding: 16px; border-radius: 8px; font-size: 18px; margin-top: 25px; cursor: pointer; font-weight: bold; }
        
        /* Congratulatory Popup */
        #successModal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); z-index: 100; justify-content: center; align-items: center; text-align: center; padding: 20px; }
        .modal-content { background: #fff; padding: 35px; border-radius: 25px; max-width: 400px; border-top: 12px solid var(--gold); }
        .modal-content h1 { color: var(--gold); font-size: 28px; margin-bottom: 10px; }
        .mpc-reveal { font-size: 32px; font-weight: bold; color: var(--primary); background: #f1f8ff; padding: 15px; border-radius: 12px; margin: 20px 0; border: 3px dashed var(--gold); letter-spacing: 2px; }
        .close-btn { background: #333; color: white; padding: 10px 20px; border: none; border-radius: 5px; cursor: pointer; margin-top: 10px; }
    </style>
</head>
<body>

    <!-- Reveal Modal -->
    <div id="successModal">
        <div class="modal-content">
            <h1>CONGRATULATIONS!</h1>
            <p style="font-weight: bold; color: #555;">Registration Confirmed.</p>
            <p>Your Assigned MPC Code is:</p>
            <div class="mpc-reveal" id="finalCodeDisplay">----</div>
            <button class="close-btn" onclick="closeModal()">Close & Refresh</button>
        </div>
    </div>

    <div class="card">
        <h2>SafeShop MPC Portal</h2>
        
        <form id="appForm">
            <!-- COMPULSORY FIELDS FIRST -->
            <label>Guest (Applicant) Name <span class="required-star">*</span></label>
            <input type="text" name="guest_name" id="gName" placeholder="Enter Full Name" required>

            <label>Guest of <span class="required-star">*</span></label>
            <input type="text" name="upline" id="gOf" placeholder="Enter Reference Leader Name" required>

            <label>Select MPC Number <span class="required-star">*</span></label>
            <select name="mpc_number" id="mpc_select" required onmousedown="checkRegistration(event)" onchange="autoFetchCode()">
                <option value="">-- View MPC Numbers --</option>
            </select>

            <!-- Hidden field to store MPC Code securely for sheet -->
            <input type="hidden" name="mpc_code" id="hidden_mpc_code">

            <!-- OPTIONAL FIELDS -->
            <label>MPC Issued to</label>
            <input type="text" name="leader" placeholder="Leader Name">

            <label>600 Paid?</label>
            <select name="paid">
                <option value="">-- Select --</option>
                <option value="Yes">Yes</option>
                <option value="No">No</option>
            </select>

            <label>Date of Joining</label>
            <input type="date" name="doj">

            <label>Mobile Number</label>
            <input type="tel" name="mobile" id="gMobile" maxlength="10" placeholder="10 Digit Number">

            <label>City</label>
            <input type="text" name="city" placeholder="e.g. Chirawa">

            <label>PAN Number</label>
            <input type="text" name="pan" maxlength="10" style="text-transform:uppercase" placeholder="ABCDE1234F">

            <label>Aadhar Number</label>
            <input type="text" name="aadhar" maxlength="12" placeholder="12 Digit Number">
            
            <label>Log ID</label>
            <input type="text" name="log_id" id="log_id_input" placeholder="Enter ID to unlock BV" oninput="toggleBV()">
            
            <label>Sale (BV)</label>
            <input type="number" name="bv" id="bv_input" disabled placeholder="Locked until Log ID entered">

            <label>FIM Status</label>
            <select name="fim">
                <option value="">-- Select --</option>
                <option value="Done">Done</option>
                <option value="Pending">Pending</option>
            </select>
            
            <button type="submit" class="btn" id="sBtn">Register & Reveal Code</button>
        </form>
    </div>

    <script>
        const scriptURL = '1W-7kl6X4xI3sV3gpWoOsIlyn-Jzlc7GWBdpNXdArWaA'; // PASTE YOUR LATEST DEPLOYMENT URL HERE
        let mpcData = [];

        // Intercept dropdown click if mandatory details are missing
        function checkRegistration(event) {
            const name = document.getElementById('gName').value;
            const guestOf = document.getElementById('gOf').value;

            if (name.trim() === "" || guestOf.trim() === "") {
                event.preventDefault(); 
                alert("ACCESS DENIED: Please fill in the compulsory fields (Guest Name & Guest of) first to view MPC details.");
                if(name.trim() === "") document.getElementById('gName').focus();
                else document.getElementById('gOf').focus();
            } else if (mpcData.length === 0) {
                loadMPCs();
            }
        }

        // Fetch MPC list using script injection (Bypasses CORS errors)
        window.handleMPCData = function(data) {
            mpcData = data;
            const select = document.getElementById('mpc_select');
            select.innerHTML = '<option value="">-- Select MPC Number --</option>';
            data.forEach(item => {
                let opt = document.createElement('option');
                opt.value = item.number;
                opt.innerText = item.number;
                select.appendChild(opt);
            });
        };

        function loadMPCs() {
            const script = document.createElement('script');
            script.src = scriptURL + "?callback=handleMPCData&t=" + new Date().getTime();
            document.body.appendChild(script);
        }

        // Dynamic validation for Log ID and BV field
        function toggleBV() {
            const logId = document.getElementById('log_id_input').value;
            const bvInput = document.getElementById('bv_input');
            if (logId.trim() === "") {
                bvInput.disabled = true;
                bvInput.value = "";
                bvInput.placeholder = "Locked until Log ID entered";
            } else {
                bvInput.disabled = false;
                bvInput.placeholder = "e.g. 200";
            }
        }

        function autoFetchCode() {
            const selectedNum = document.getElementById('mpc_select').value;
            const found = mpcData.find(x => x.number === selectedNum);
            if(found) {
                document.getElementById('hidden_mpc_code').value = found.code;
            }
        }

        // Form submission protocol
        document.getElementById('appForm').addEventListener('submit', e => {
            e.preventDefault();
            const btn = document.getElementById('sBtn');
            const selectedNum = document.getElementById('mpc_select').value;
            
            if (!selectedNum) {
                alert("Please select an MPC Number before submitting.");
                return;
            }

            const found = mpcData.find(x => x.number === selectedNum);
            const revealedCode = found ? found.code : "N/A";

            document.getElementById('hidden_mpc_code').value = revealedCode;

            btn.disabled = true;
            btn.innerText = "Saving Entry...";
            
            fetch(scriptURL, { method: 'POST', body: new FormData(e.target)})
            .then(() => { 
                document.getElementById('finalCodeDisplay').innerText = revealedCode;
                document.getElementById('successModal').style.display = 'flex';
                e.target.reset();
                toggleBV();
                btn.disabled = false;
                btn.innerText = "Register & Reveal Code";
            })
            .catch(() => {
                alert("Submission timed out, but please check your spreadsheet before resubmitting.");
                btn.disabled = false;
                btn.innerText = "Register & Reveal Code";
            });
        });

        function closeModal() {
            document.getElementById('successModal').style.display = 'none';
            location.reload(); 
        }

        // Pre-fetch data dynamically when user moves away from mandatory input fields
        document.getElementById('gOf').onblur = loadMPCs;
    </script>
</body>
</html>
